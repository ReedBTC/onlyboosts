[Unit]
Description=OnlyBoosts daily podroll refresh (<podcast:podroll> from raw RSS) + export + VPS/D1 push
After=network-online.target
Wants=network-online.target
# Non-zero exit opens a GitHub issue. Note the pass swallows per-feed failures by
# design (a 429 is recorded as a status, not an error), so this fires only on a
# real breakage — the collector crashing, or a push being rejected.
OnFailure=lb-bot-alert@%n.service

[Service]
Type=oneshot
User=reed
WorkingDirectory=/home/reed/onlyboosts/bots/global-boost-scan
ExecStart=/home/reed/onlyboosts/bots/global-boost-scan/run-podroll.sh
# ~900 feeds, serialized per host: the largest host alone is a few minutes.
TimeoutStartSec=5400
StandardOutput=journal
StandardError=journal
