.DS_Store

# --- Claude Code local settings ---
.claude/settings.local.json

# --- Wrangler local dev server scratch (created by `wrangler pages dev`) ---
.wrangler/

# --- Bots: operational state (regenerable from Nostr) ---
bots/**/state.json
bots/**/state.json.bak
bots/**/state.json.before-*
bots/**/*.lock
bots/**/state_*.json
bots/**/last_seen.txt
bots/**/last_seen.txt.bak

# --- Bots: local backup dirs created before refactors ---
bots/**/*.bak/

# --- Bots: working files / private docs ---
bots/tmp/
bots/CLAUDE.md

# --- Boost snapshot data: lives on the VPS (relay.mynostr.app), pushed by
# the collector bot via rsync and served by Caddy — deliberately NOT
# committed, that's the whole point of the VPS-push design (it avoids an
# hourly git push + Pages rebuild). The site reads it through
# functions/api/data/[[path]].js.
#
# Anchored with a leading slash on purpose: a bare `data/` matches ANY
# directory named data at any depth, which silently swallowed
# functions/api/data/ (the proxy Function) on first commit.
/data/

# --- Python ---
bots/**/__pycache__/
bots/**/*.pyc
bots/.claude/

# --- Node ---
node_modules/

# --- Local-only scratch + secrets (never commit) ---
tmp/
scratchpad/
*creds*.env
# wrangler's local env file — holds PODCAST_INDEX_KEY / PODCAST_INDEX_SECRET
# for `wrangler pages dev`. The deployed values live in the Cloudflare
# dashboard; this file is the machine-local equivalent and is a real secret.
.dev.vars
.dev.vars.*
